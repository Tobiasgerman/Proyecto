{
  "version": 2,
  "builds": [
    {
      "src": "Back/api-server.js",
      "use": "@vercel/node"
    },
    {
      "src": "Front/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Back/api-server.js"
    },
    {
      "src": "/(.*)",
      "dest": "Front/$1"
    }
  ]
}
